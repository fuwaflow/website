---
import Layout from "../layouts/layout.astro";
import { NAME, USERNAME } from "../layouts/layout.astro";
---

<Layout title={NAME}>
  <main>
    <!-- hero/intro section -->
    <section>
      <h1 style="color: var(--accent);" class="h0">{NAME}</h1>
      <p>
        hi!!! welcome to my little corner of the internet! i'm <strong
          >{NAME}</strong
        >, a hobbyist designer and maker! i really love open source and i enjoy
        making apps for the <a href="https://gnome.org/">GNOME</a> and <a
          href="https://elementary.io/">elementary</a
        > ecosystems. i also love dabbling in app development for Apple platforms
        whenever i get the chance!
      </p>
      <p>
        this website is where i'll showcase the work i'm proud of, and share
        projects and people i find cool! feel free to take a look around!
      </p>
      <hr />
    </section>

    <!-- about me section -->
    <section>
      <h2>about me</h2>
      <p>
        i like making designs that are capable but easy to understand. a big
        part of design to me is it being a medium to make the content
        shine—whilst also having character.
      </p>
      <blockquote>
        <p>
          True simplicity is derived from so much more than just the absence of
          clutter and ornamentation. It's about bringing order to complexity.
        </p>
        <cite>— jony ive</cite>
      </blockquote>
      <hr />
    </section>

    <!-- current work section -->
    <section>
      <h2>what i'm working on now</h2>
      <p>current projects</p>
      <div class="card-grid large">
        <a href="https://github.com/fuwaflow/usagi" class="card">
          <img
            class="card-image"
            src="https://raw.githubusercontent.com/fuwaflow/usagi/main/.github/assets/banner.png"
            alt="usagi linux distro pantheon desktop"
          />
          <h3 class="card-title">usagi</h3>
          <p class="card-description">fedora atomic image with pantheon!</p>
        </a>
        <a href="https://github.com/fuwaflow/cosie-css" class="card">
          <img
            class="card-image"
            src="https://repository-images.githubusercontent.com/1190567909/378cba02-a85a-4f87-a1a5-4992093c6122"
            alt="cosie-css styled website"
          />
          <h3 class="card-title">cosie-css</h3>
          <p class="card-description">my opinionated css stylesheet</p>
        </a>
        <a href="https://github.com/fuwaflow/zmk-config" class="card">
          <img
            class="card-image"
            src="https://repository-images.githubusercontent.com/853885955/efb6429a-9762-4001-9f05-78d12e400623"
            alt="crkbd corne choc split keyboard"
          />
          <h3 class="card-title">zmk-config</h3>
          <p class="card-description">
            zmk firmware config for my corne choc keyboard
          </p>
        </a>
      </div>
      <hr />
    </section>

    <!-- past experience section -->
    <section>
      <h2>past experience</h2>
      <p>things i've worked on and learned from</p>
      <div class="card-grid large">
        <a href="https://buildtheearth.net" class="card">
          <img
            class="card-image"
            src="https://cdn.buildtheearth.net/uploads/6be3d752b5556540625c4df4f8b8db643745d239bc3fa71213818e34f3b677bf"
            alt="buildtheearth minecraft project"
          />
          <h3 class="card-title">BuildTheEarth.net</h3>
          <p class="card-description">
            guinness world record minecraft project. i was a team manager &
            system admin.
          </p>
        </a>
        <a href="https://github.com/Avdan-OS/" class="card">
          <img
            class="card-image"
            src="https://avdanos.org/_next/static/media/preview1.c0dcd8fd.jpg"
            alt="avdanos linux desktop environment"
          />
          <h3 class="card-title">AvdanOS</h3>
          <p class="card-description">
            linux desktop environment ui designer. i made mockups & design
            systems (2022–2023).
          </p>
        </a>
      </div>
      <hr />
    </section>

    <!-- cool projects section -->
    <section>
      <h2>projects i love</h2>
      <p>ecosystem & tools i'm passionate about:</p>
      <div class="card-grid large">
        <a href="https://elementary.io/" class="card">
          <img
            class="card-image"
            src="https://elementary.io/images/screenshots/desktop.jpg"
            alt=""
          />
          <h3 class="card-title">elementaryOS</h3>
          <p class="card-description">
            a beautiful, accessible, well-designed linux distribution.
          </p>
        </a>
        <a href="https://natsumi.greeeen.dev/" class="card">
          <img
            class="card-image"
            src="https://github.com/greeeen-dev/natsumi-browser/blob/main/images/main.webp?raw=true"
            alt=""
          />
          <h3 class="card-title">Natsumi Browser</h3>
          <p class="card-description">
            an awesome userchrome theme for firefox and forks.
          </p>
        </a>
        <a href="https://gnome.org/" class="card">
          <img
            class="card-image"
            src="https://os.gnome.org/assets/nightly.webp"
            alt=""
          />
          <h3 class="card-title">GNOME</h3>
          <p class="card-description">
            a linux desktop ecosystem, with great design and accessibility.
          </p>
        </a>
      </div>
      <hr />
    </section>

    <!-- cool people section -->
    <section>
      <h2>cool people</h2>
      <p>really talented people i admire and love collaborating with:</p>
      <div class="card-grid">
        <a href="https://fizzyizzy05.dev/" class="card horizontal">
          <img
            class="card-image"
            src="https://avatars.githubusercontent.com/u/85719751?v=4"
            alt=""
          />
          <h3 class="card-title">Izzy</h3>
        </a>
        <a href="https://zeldathewitch.page/" class="card horizontal">
          <img
            class="card-image"
            src="https://avatars.githubusercontent.com/u/239873844?v=4"
            alt=""
          />
          <h3 class="card-title">Zoey</h3>
        </a>
        <a href="https://tesk.page/" class="card horizontal">
          <img
            class="card-image"
            src="https://avatars.githubusercontent.com/u/50847364?v=4"
            alt=""
          />
          <h3 class="card-title">TheEvilSkeleton</h3>
        </a>
        <a href="https://kramo.page/" class="card horizontal">
          <img
            class="card-image"
            src="https://avatars.githubusercontent.com/u/93832451?v=4"
            alt=""
          />
          <h3 class="card-title">kramo</h3>
        </a>
        <a href="https://jamie.garden/" class="card horizontal">
          <img
            class="card-image"
            src="https://gitlab.gnome.org/uploads/-/system/user/avatar/112136/avatar.png"
            alt=""
          />
          <h3 class="card-title">Jamie</h3>
        </a>
        <a href="https://greeeen.dev/" class="card horizontal">
          <img
            class="card-image"
            src="https://avatars.githubusercontent.com/u/41323182?v=4"
            alt=""
          />
          <h3 class="card-title">green</h3>
        </a>
        <a href="https://github.com/heliguy4599" class="card horizontal">
          <img
            class="card-image"
            src="https://avatars.githubusercontent.com/u/95997226?v=4"
            alt=""
          />
          <h3 class="card-title">Heliguy</h3>
        </a>
      </div>
      <hr />
    </section>

    <!-- find me section -->
    <section>
      <h2>find me</h2>
      <ul>
        <li>
          <a href={`https://github.com/${USERNAME}`}>github</a>
        </li>
        <li>
          <a href="https://mastodon.social/@linuxjava7">mastodon</a>
        </li>
      </ul>
      <hr />
    </section>

    <p>thanks for visiting!! ❤️</p>
  </main>
</Layout>
